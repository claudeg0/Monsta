.env.production
# Any per-environment override, and any backup copy of an env file. Both
# routinely end up holding real credentials while looking inert - a .bak of
# .env.development with a live GOOGLE_CLIENT_SECRET in it was one `git add -A`
# away from being published.
.env*.local
*.bak
.log
.vscode/*
npm-debug.log
stats.json
.DS_Store
data/*
.idea
*.pem
*.key
*.cert
.history

